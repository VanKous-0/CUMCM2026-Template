% cumcm2026.sty --- 全国大学生数学建模竞赛论文（2026 年修订稿）辅助样式
% Copyright 2026 Jiayi
% GitHub: @langonginc
% 编译引擎：XeLaTeX
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cumcm2026}[2026/08/22 CUMCM 2026 community paper template]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{cumcm2026}
    {This template requires XeLaTeX}
    {Please select XeLaTeX as the compiler and compile main.tex again.}
\fi

% 本样式依赖 ctexart 提供的中文排版命令，但不重复加载 ctex，以免选项冲突。
\makeatletter
\@ifundefined{ctexset}{%
  \PackageError{cumcm2026}
    {The ctex document class is required}
    {Use \string\documentclass[UTF8,a4paper,zihao=-4]{ctexart}.}%
}{}
\@ifundefined{zihao}{%
  \PackageError{cumcm2026}
    {The ctex font-size command is unavailable}
    {Use \string\documentclass[UTF8,a4paper,zihao=-4]{ctexart}.}%
}{}
\makeatother

\RequirePackage[a4paper,margin=2.5cm]{geometry}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{graphicx}
\RequirePackage{booktabs,tabularx,multirow}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}

% 版心与正文。1.25 倍行距是模板的保守默认选择，并非竞赛统一要求。
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\linespread{1.25}

% 普通列表保持紧凑但可读；问题列表使用固定标签宽度保证标签和正文严格对齐。
\setlist[itemize]{leftmargin=2.3em,itemsep=0.25em,topsep=0.5em,parsep=0pt,partopsep=0pt}
\setlist[enumerate]{leftmargin=2.8em,itemsep=0.25em,topsep=0.5em,parsep=0pt,partopsep=0pt}
\newlist{problemlist}{enumerate}{1}
\setlist[problemlist]{%
  label={问题\arabic*：},
  labelwidth=4.5em,
  labelsep=0.5em,
  leftmargin=5em,
  align=left,
  itemindent=0pt,
  listparindent=0pt,
  itemsep=0.35em,
  topsep=0.5em,
  parsep=0pt,
  partopsep=0pt
}

% 图题在图下，表题在表上；均采用适合打印的黑白样式。
\captionsetup{font=small,labelsep=space}
\captionsetup[figure]{position=bottom}
\captionsetup[table]{position=top}

% 无页眉，页脚中央连续页码；plain 样式（如参考文献页）同样适用。
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% 标题字号与间距是模板默认样式；官方规范未统一规定字体、字号、行距和颜色。
\ctexset{
  section = {
    format=\zihao{4}\bfseries,
    beforeskip=1.5ex plus 0.3ex minus 0.2ex,
    afterskip=0.8ex plus 0.1ex,
    aftername=\quad
  },
  subsection = {
    format=\zihao{-4}\bfseries,
    beforeskip=1.2ex plus 0.2ex minus 0.1ex,
    afterskip=0.6ex plus 0.1ex,
    aftername=\quad
  },
  subsubsection = {
    format=\zihao{-4}\bfseries,
    beforeskip=1.0ex plus 0.2ex minus 0.1ex,
    afterskip=0.5ex,
    aftername=\quad
  }
}

% 隐藏链接边框和颜色，同时清空可能暴露身份的作者元数据。
\hypersetup{
  hidelinks,
  pdfauthor={},
  pdftitle={全国大学生数学建模竞赛论文}
}

% 黑白、可打印且无需 shell-escape 的代码样式。
\lstset{
  basicstyle=\small\ttfamily,
  frame=single,
  rulecolor=\color{black},
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  numbers=left,
  numberstyle=\tiny,
  numbersep=8pt,
  showstringspaces=false,
  keywordstyle=\bfseries,
  commentstyle=\itshape,
  stringstyle=\normalfont\ttfamily,
  captionpos=b
}

% 摘要页命令。请先用 \title 和 \mcmkeywords 设置标题、关键词。
\makeatletter
\newcommand{\mcmkeywords}[1]{\gdef\@mcmkeywords{#1}}
\newcommand{\@mcmkeywords}{}
\newcommand{\makemcmabstracttitle}{%
  \begin{center}
    {\zihao{3}\bfseries \@title\par}
  \end{center}
  \vspace{0.8em}
}
\newenvironment{mcmabstract}{%
  \makemcmabstracttitle
  \noindent\textbf{摘\quad 要}\quad\ignorespaces
}{%
  \par\vspace{0.8em}
  \noindent\textbf{关键词}\quad \@mcmkeywords\par
}
\makeatother

% 附录中的程序清单：可选 listings 参数、显示标题、实际源文件路径。
\newcommand{\sourcefile}[3][]{\lstinputlisting[caption={#2},#1]{#3}}

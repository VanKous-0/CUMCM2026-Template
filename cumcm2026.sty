% 编译引擎：XeLaTeX
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cumcm2026}[2026/08/22 CUMCM 2026 community paper template]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{cumcm2026}
    {This template requires XeLaTeX}
    {Please select XeLaTeX as the compiler and compile main.tex again.}
\fi

% 本样式依赖 ctexart 提供的中文排版命令，但不重复加载 ctex，以免选项冲突。
\makeatletter
\@ifundefined{ctexset}{%
  \PackageError{cumcm2026}
    {The ctex document class is required}
    {Use \string\documentclass[UTF8,a4paper,zihao=-4]{ctexart}.}%
}{}
\@ifundefined{zihao}{%
  \PackageError{cumcm2026}
    {The ctex font-size command is unavailable}
    {Use \string\documentclass[UTF8,a4paper,zihao=-4]{ctexart}.}%
}{}
\makeatother

\RequirePackage[a4paper,margin=2.5cm]{geometry}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{graphicx}
\RequirePackage{booktabs,tabularx,multirow}
\RequirePackage{array,longtable}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}

% 版心与正文。1.25 倍行距是模板的保守默认选择，并非竞赛统一要求。
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\linespread{1.25}

% 普通列表保持紧凑但可读；问题列表使用固定标签宽度保证标签和正文严格对齐。
\setlist[itemize]{leftmargin=2.3em,itemsep=0.25em,topsep=0.5em,parsep=0pt,partopsep=0pt}
\setlist[enumerate]{leftmargin=2.8em,itemsep=0.25em,topsep=0.5em,parsep=0pt,partopsep=0pt}
\newlist{problemlist}{enumerate}{1}
\newcommand{\problemlabel}[1]{{\xeCJKsetup{CJKecglue={}}问题#1：}}
\setlist[problemlist]{%
  label={\problemlabel{\arabic*}},
  labelwidth=4.5em,
  labelsep=0.5em,
  leftmargin=5em,
  align=left,
  itemindent=0pt,
  listparindent=0pt,
  itemsep=0.35em,
  topsep=0.5em,
  parsep=0pt,
  partopsep=0pt
}

% 图题在图下，表题在表上；均采用适合打印的黑白样式。
\captionsetup{font=small,labelsep=space}
\captionsetup[figure]{position=bottom}
\captionsetup[table]{position=top}

% 无页眉，页脚中央连续页码；plain 样式（如参考文献页）同样适用。
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% 标题字号与间距是模板默认样式；官方规范未统一规定字体、字号、行距和颜色。
\ctexset{
  section = {
    name={,、},
    number=\chinese{section},
    format=\zihao{4}\bfseries,
    beforeskip=1.7ex plus 0.3ex minus 0.2ex,
    afterskip=0.9ex plus 0.1ex,
    aftername=\quad
  },
  subsection = {
    number=\arabic{section}.\arabic{subsection},
    format=\zihao{-4}\bfseries,
    beforeskip=1.2ex plus 0.2ex minus 0.1ex,
    afterskip=0.6ex plus 0.1ex,
    aftername=\quad
  },
  subsubsection = {
    number=\arabic{section}.\arabic{subsection}.\arabic{subsubsection},
    format=\zihao{-4}\bfseries,
    beforeskip=1.0ex plus 0.2ex minus 0.1ex,
    afterskip=0.5ex,
    aftername=\quad
  }
}

% 附录恢复 A、B、C 编号，避免正文中文数字编号影响附录习惯。
\newcommand{\mcmappendix}{%
  \appendix
  \ctexset{section={name={,},number=\Alph{section},aftername=\quad}}%
}

% 可跨页的三线符号表。可选参数为表题，\label 可紧跟在环境开始之后。
\newenvironment{symboltable}[1][主要符号说明]{%
  \renewcommand{\arraystretch}{1.18}%
  \begin{longtable}{@{}>{\centering\arraybackslash}p{0.15\textwidth}p{0.59\textwidth}>{\centering\arraybackslash}p{0.15\textwidth}@{}}
    \caption{#1}\\
    \toprule
    符号 & 含义 & 单位 \\
    \midrule
    \endfirsthead
    \multicolumn{3}{r}{续表}\\
    \toprule
    符号 & 含义 & 单位 \\
    \midrule
    \endhead
    \midrule
    \multicolumn{3}{r}{下页续表}\\
    \endfoot
    \bottomrule
    \endlastfoot
}{%
  \end{longtable}
}

% 图形/算法流程图占位框：参数依次为高度、图题和引用标签。
\newcommand{\figureplaceholder}[3][4.2cm]{%
  \begin{figure}[H]
    \centering
    \fbox{\parbox[c][#1][c]{0.82\textwidth}{%
      \centering\small 图形占位：请替换为 \texttt{\string\includegraphics}%
    }}
    \caption{#2}
    \label{#3}
  \end{figure}
}

% 隐藏链接边框和颜色，同时清空可能暴露身份的作者元数据。
\hypersetup{
  hidelinks,
  pdfauthor={},
  pdftitle={全国大学生数学建模竞赛论文}
}

% 黑白、可打印且无需 shell-escape 的代码样式。
\lstset{
  basicstyle=\footnotesize\ttfamily,
  frame=single,
  rulecolor=\color{black},
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  numbers=left,
  numberstyle=\tiny,
  numbersep=8pt,
  xleftmargin=1.5em,
  framexleftmargin=1.2em,
  aboveskip=0.8em,
  belowskip=0.8em,
  showstringspaces=false,
  keywordstyle=\bfseries,
  commentstyle=\itshape,
  stringstyle=\normalfont\ttfamily,
  postbreak=\mbox{\textnormal{\scriptsize$\hookrightarrow$}\space},
  captionpos=t
}
\renewcommand{\lstlistingname}{代码}

% 摘要页命令。请先用 \title 和 \mcmkeywords 设置标题、关键词。
\makeatletter
\newcommand{\mcmkeywords}[1]{\gdef\@mcmkeywords{#1}}
\newcommand{\@mcmkeywords}{}
\newcommand{\makemcmabstracttitle}{%
  \begin{center}
    {\zihao{3}\bfseries \@title\par}
  \end{center}
  \vspace{0.8em}
}
\newenvironment{mcmabstract}{%
  \begingroup
  \linespread{1.18}\selectfont
  \makemcmabstracttitle
  \noindent\textbf{摘\quad 要：}\quad\ignorespaces
}{%
  \par\vspace{0.7em}
  \noindent\textbf{关键词：}\@mcmkeywords\par
  \endgroup
}
\makeatother

% 附录中的程序清单：可选 listings 参数、显示标题、实际源文件路径。
\newcommand{\sourcefile}[3][]{\lstinputlisting[caption={#2},#1]{#3}}
